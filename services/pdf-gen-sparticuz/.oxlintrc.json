{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/*.mjs"],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.js"],
      "rules": {
        "no-console": "off",
        "typesafe/no-throw-sync-func": "off"
      },
      "jsPlugins": ["eslint-plugin-typesafe"]
    }
  ]
}
