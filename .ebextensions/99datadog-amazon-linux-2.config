# .ebextensions/99datadog.config
option_settings:
    - namespace: aws:elasticbeanstalk:application:environment
      option_name: DD_AGENT_HOST
      value: ""
    - namespace: aws:elasticbeanstalk:application:environment
      option_name: DD_AGENT_MAJOR_VERSION
      value: "7"
    - namespace: aws:elasticbeanstalk:application:environment
      option_name: DD_AGENT_MINOR_VERSION
      value: "" # Eg: 34 to install 7.34.x, leave empty to install the latest 7.x

files:
  "/etc/datadog-agent/datadog.yaml":
    mode: "000640"
    owner: root # will be changed to dd-agent after the installation
    group: root
    content: |
      # Add here the Agent configuration
      api_key: @DD_API_KEY
      site: datadoghq.com
      logs_enabled: true
      dogstatsd_non_local_traffic: true
      apm_config:
        enabled: true
        apm_non_local_traffic: true
      tags:
        - service:formsg
        - env:@DD_ENV

  "/etc/datadog-agent/conf.d/mongo.d/conf.yaml":
      mode: "000640"
      owner: root # will be changed to dd-agent after the installation
      group: root
      content: |
        init_config:
        instances:
          - hosts:
              - @DD_AGENT_MONGODB_HOST_IP_PRIMARY:27017  # Primary node
            username: @DD_AGENT_MONGODB_USER
            password: @DD_AGENT_MONGODB_PASSWORD
            options:
              authSource: admin
            tls: true
            dbm: true
            cluster_name: formsg
            # reported_database_hostname: <DATABASE_HOSTNAME_OVERRIDE>
            additional_metrics: ["metrics.commands", "tcmalloc", "top", "collection"]
            collections_indexes_stats: true
            database_autodiscovery:
              enabled: true
          # - hosts:
          #     - DD_AGENT_MONGODB_HOST_IP_SECONDARY_1:27017  # Secondary node
          #   username: @DD_AGENT_MONGODB_USER
          #   password: @DD_AGENT_MONGODB_PASSWORD
          #   options:
          #     authSource: admin
          #   tls: true
          #   dbm: true
          #   cluster_name: formsg
          #   # reported_database_hostname: <DATABASE_HOSTNAME_OVERRIDE>
          #   additional_metrics: ["metrics.commands", "tcmalloc", "top", "collection"]
          #   collections_indexes_stats: true
          #   database_autodiscovery:
          #     enabled: true
          # - hosts:
          #     - @DD_AGENT_MONGODB_HOST_IP_SECONDARY_2:27017  # Secondary node
          #   username: @DD_AGENT_MONGODB_USER
          #   password: @DD_AGENT_MONGODB_PASSWORD
          #   options:
          #     authSource: admin
          #   tls: true
          #   dbm: true
          #   cluster_name: formsg
          #   # reported_database_hostname: <DATABASE_HOSTNAME_OVERRIDE>
          #   additional_metrics: ["metrics.commands", "tcmalloc", "top", "collection"]
          #   collections_indexes_stats: true
          #   database_autodiscovery:
          #     enabled: true
          # - hosts:
          #     - @DD_AGENT_MONGODB_HOST_IP_ANALYTICS_1:27017  # analytics node, non-electable replica
          #   username: @DD_AGENT_MONGODB_USER
          #   password: @DD_AGENT_MONGODB_PASSWORD
          #   options:
          #     authSource: admin
          #   tls: true
          #   dbm: true
          #   cluster_name: formsg
          #   # reported_database_hostname: <DATABASE_HOSTNAME_OVERRIDE>
          #   additional_metrics: ["metrics.commands", "tcmalloc", "top", "collection"]
          #   collections_indexes_stats: true
          #   database_autodiscovery:
          #     enabled: true

  "/datadog_install_script.sh":
    mode: "000700"
    owner: root
    group: root
    source: https://s3.amazonaws.com/dd-agent/scripts/install_script.sh

container_commands:
    05setup_datadog:
        command: "DD_API_KEY=unused /datadog_install_script.sh; sed -i 's/ install_script/ ebs_install_script/' /etc/datadog-agent/install_info"
