{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "apps/frontend/node_modules",
    "apps/frontend/.pnp",
    "apps/frontend/.pnp.js",
    "apps/frontend/coverage",
    "apps/frontend/build",
    "apps/frontend/.DS_Store",
    "apps/frontend/.env.local",
    "apps/frontend/.env.development.local",
    "apps/frontend/.env.test.local",
    "apps/frontend/.env.production.local",
    "apps/frontend/npm-debug.log*",
    "apps/frontend/yarn-debug.log*",
    "apps/frontend/yarn-error.log*",
    "apps/frontend/storybook-static",
    "apps/frontend/build-storybook.log",
    "apps/frontend/tsconfig.json",
    "apps/frontend/**/assets/**/*.json",
    "apps/frontend/CREDITS.md",
    "apps/backend/src/app/views/templates/submit-form-summary-pdf.server.view.html"
  ],
  "overrides": [
    {
      "files": ["apps/frontend/**"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["packages/sdk/**"],
      "options": {
        "trailingComma": "es5"
      }
    }
  ]
}
