{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": false,
    "customGroups": [
      {
        "groupName": "src-alias",
        "elementNamePattern": ["src", "src/**"]
      },
      {
        "groupName": "tests-alias",
        "elementNamePattern": ["tests", "tests/**"]
      }
    ],
    "groups": [
      "side_effect",
      ["builtin", "external"],
      "src-alias",
      "tests-alias",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "CHANGELOG.md",
    "apps/frontend/node_modules",
    "apps/frontend/.pnp",
    "apps/frontend/.pnp.js",
    "apps/frontend/coverage",
    "apps/frontend/build",
    "apps/frontend/.DS_Store",
    "apps/frontend/.env.local",
    "apps/frontend/.env.development.local",
    "apps/frontend/.env.test.local",
    "apps/frontend/.env.production.local",
    "apps/frontend/npm-debug.log*",
    "apps/frontend/yarn-debug.log*",
    "apps/frontend/yarn-error.log*",
    "apps/frontend/storybook-static",
    "apps/frontend/build-storybook.log",
    "apps/frontend/tsconfig.json",
    "apps/frontend/**/assets/**/*.json",
    "apps/frontend/CREDITS.md",
    "apps/backend/src/app/views/templates/submit-form-summary-pdf.server.view.html"
  ],
  "overrides": [
    {
      "files": ["apps/frontend/**"],
      "options": {
        "tabWidth": 2,
        "sortImports": {
          "newlinesBetween": true,
          "sortSideEffects": false,
          "customGroups": [
            {
              "groupName": "react",
              "elementNamePattern": [
                "react",
                "react/**",
                "react-*",
                "react-*/**"
              ]
            },
            {
              "groupName": "formsg-shared",
              "elementNamePattern": ["formsg-shared", "formsg-shared/**"]
            },
            {
              "groupName": "alias-root",
              "elementNamePattern": ["~", "~/**"]
            },
            {
              "groupName": "alias-typings",
              "elementNamePattern": ["~typings", "~typings/**"]
            },
            {
              "groupName": "alias-lib",
              "elementNamePattern": [
                "~assets",
                "~assets/**",
                "~theme",
                "~theme/**",
                "~contexts",
                "~contexts/**",
                "~constants",
                "~constants/**",
                "~hooks",
                "~hooks/**",
                "~utils",
                "~utils/**",
                "~services",
                "~services/**",
                "~components",
                "~components/**",
                "~templates",
                "~templates/**"
              ]
            },
            {
              "groupName": "alias-app",
              "elementNamePattern": [
                "~pages",
                "~pages/**",
                "~features",
                "~features/**"
              ]
            }
          ],
          "groups": [
            "side_effect",
            "react",
            ["builtin", "external"],
            "formsg-shared",
            "alias-root",
            "alias-typings",
            "alias-lib",
            "alias-app",
            ["parent", "sibling", "index"],
            "unknown"
          ]
        }
      }
    },
    {
      "files": ["packages/sdk/**"],
      "options": {
        "trailingComma": "es5"
      }
    }
  ]
}
