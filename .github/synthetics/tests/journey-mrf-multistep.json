{
  "name": "[formsg-smoke] MRF multi-step: workflow invite, step 2 via email link",
  "type": "browser",
  "status": "paused",
  "message": "CI smoke journey \u2014 create MRF form with a 2-step workflow (step 2 = static email), publish, submit step 1 publicly, open the 'Action required' invitation from the mailbox, complete step 2. Runs only via CI triggers. Steps named PLACEHOLDER must be recorded once in the Datadog UI (email OTP extraction has no public API schema), then reconciled with sync.sh pull.",
  "tags": [
    "team:formsg",
    "ci:formsg-smoke",
    "managed-by:formsg-repo"
  ],
  "locations": [
    "aws:ap-southeast-1"
  ],
  "config": {
    "request": {
      "method": "GET",
      "url": "{{ START_URL }}/login"
    },
    "variables": [
      {
        "name": "EMAIL",
        "type": "email",
        "pattern": "3h3-5yd-uxe.{{ numeric(10) }}@synthetics.dtdg.co",
        "example": "3h3-5yd-uxe.0000000000@synthetics.dtdg.co"
      },
      {
        "name": "FORMSG_SYNTHETIC_OTP_LAMBDA_SECRET",
        "type": "global",
        "id": "59963953-ff6e-4c02-bcce-74eafdc42102"
      }
    ],
    "configVariables": [
      {
        "name": "START_URL",
        "type": "text",
        "pattern": "https://stg.form.gov.sg",
        "example": "https://stg.form.gov.sg"
      }
    ]
  },
  "options": {
    "device_ids": [
      "chrome.laptop_large"
    ],
    "tick_every": 604800,
    "min_failure_duration": 0,
    "retry": {
      "count": 2,
      "interval": 5000
    }
  },
  "steps": [
    {
      "type": "typeText",
      "name": "Enter login email",
      "timeout": 60,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [
              {
                "type": "css",
                "value": "input[name='email']"
              }
            ]
          }
        },
        "value": "internal-testing+mrf@open.gov.sg"
      }
    },
    {
      "type": "click",
      "name": "Request OTP",
      "timeout": 60,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [
              {
                "type": "css",
                "value": "form:has(input[name='email']) button[type='submit']"
              }
            ]
          }
        }
      }
    },
    {
      "type": "runApiTest",
      "name": "Retrieve login OTP from internal-testing mailbox",
      "timeout": 180,
      "params": {
        "request": {
          "config": {
            "assertions": [
              {
                "operator": "is",
                "type": "statusCode",
                "target": 200
              }
            ],
            "request": {
              "headers": {
                "X-FormSG-Shared-Secret": "{{ FORMSG_SYNTHETIC_OTP_LAMBDA_SECRET }}"
              },
              "method": "GET",
              "url": "https://ltspmhqnt74sycneytbc5vjoeu0zmgnk.lambda-url.ap-southeast-1.on.aws/?to=internal-testing%2Bmrf@open.gov.sg"
            }
          },
          "options": {
            "retry": {
              "count": 5,
              "interval": 10000
            },
            "extract_values": [
              {
                "name": "OTP_RESPONSE",
                "parser": {
                  "type": "raw"
                },
                "secure": false,
                "type": "http_body"
              }
            ],
            "httpVersion": "http1"
          },
          "subtype": "http"
        }
      }
    },
    {
      "type": "extractFromJavascript",
      "name": "Extract login OTP into LOGIN_OTP",
      "timeout": 60,
      "params": {
        "code": "return JSON.parse(vars.OTP_RESPONSE).otp",
        "variable": {
          "name": "LOGIN_OTP",
          "example": ""
        }
      }
    },
    {
      "type": "typeText",
      "name": "Enter login OTP",
      "timeout": 60,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [
              {
                "type": "css",
                "value": "input[name='otp']"
              }
            ]
          }
        },
        "value": "{{ LOGIN_OTP }}"
      }
    },
    {
      "type": "click",
      "name": "Sign in",
      "timeout": 60,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [
              {
                "type": "css",
                "value": "form:has(input[name='otp']) button[type='submit']"
              }
            ]
          }
        }
      }
    },
    {
