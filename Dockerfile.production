# syntax=docker/dockerfile:1

# Base stage with common dependencies
FROM node:hydrogen-alpine3.19 AS base
WORKDIR /build

# node-modules-builder stage installs/compiles the node_modules folder
# Python version must be specified starting in alpine3.12
RUN apk update && apk upgrade && \
    apk add --virtual native-deps \
    g++ gcc libgcc libstdc++ linux-headers autoconf automake make nasm python3 git curl && \
    npm install --quiet node-gyp -g

FROM base as shared-build 
WORKDIR /build/shared
COPY shared/package.json shared/package-lock.json ./
RUN npm ci --legacy-peer-deps

FROM base AS frontend-build
WORKDIR /build/frontend

COPY --from=shared-build /build/shared/node_modules ./shared/node_modules
COPY shared/ ./shared/

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY frontend/ ./

# Set build options - these options are only used in the build stage, not the start stage.
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build 

FROM base AS backend-build
WORKDIR /build/backend

COPY --from=shared-build /build/shared/node_modules ./shared/node_modules
COPY shared/ ./shared/

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps 

COPY src/ ./src/
COPY tsconfig*.json ./

RUN npm run build:backend

# Sourcemap upload stage
# Upload datadog source maps from secret mount, id MUST be `id=dd_api_key` in the docker build command
# Mount creates a file inside /run/secrets/dd_api_key, and source to load the environment variables
# For the content of the mounted file is only accessible in the RUN command where it’s referred in, use && command.
FROM frontend-build AS sourcemap-upload
ARG APP_VERSION
ARG APP_URL
ARG REPO_URL
# Upload sourcemaps to Datadog
RUN --mount=type=secret,id=dd_api_key \
    export DATADOG_API_KEY=$(cat /run/secrets/dd_api_key) && \
    npx @datadog/datadog-ci sourcemaps upload ./dist \
    --service=formsg-react \
    --release-version=$APP_VERSION \
    --minified-path-prefix=$APP_URL \
    --repository-url=$REPO_URL

# Final production stage
FROM node:hydrogen-alpine3.19
LABEL maintainer=FormSG<form@open.gov.sg>
WORKDIR /opt/formsg

# Install runtime dependencies
RUN apk add --no-cache \
    chromium=124.0.6367.78-r0 \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    tini

# Configure Puppeteer
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV CHROMIUM_BIN=/usr/bin/chromium-browser

# Install Chinese font support
RUN apk add font-wqy-zenhei --repository https://dl-cdn.alpinelinux.org/alpine/edge/community

COPY --from=shared-build /build/shared/node_modules /opt/formsg/node_modules

COPY --from=frontend-build /build/frontend/node_modules /opt/formsg/node_modules    
COPY --from=frontend-build /build/frontend/dist /opt/formsg/dist

COPY --from=backend-build /build/backend/node_modules /opt/formsg/node_modules    
COPY --from=backend-build /build/backend/package.json /opt/formsg/package.json
COPY --from=backend-build /build/backend/dist /opt/formsg/dist

# Built backend goes back to root working directory
RUN mv /opt/formsg/dist/backend/src /opt/formsg/
RUN mv /opt/formsg/dist/backend/shared /opt/formsg/

# Set up non-privileged user
RUN addgroup -S formsguser && adduser -S -g formsguser formsguser
USER formsguser

# Set production environment
ENV NODE_ENV=production
EXPOSE 4545

# Use tini as init process
ENTRYPOINT [ "tini", "--" ]
CMD [ "npm", "start" ]