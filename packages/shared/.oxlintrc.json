{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../tooling/oxlint/base.json"],
  "plugins": [],
  "env": {
    "node": true
  },
  "ignorePatterns": ["**/dist"],
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.{js,jsx,ts,tsx}",
        "**/*.{spec,test}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
