{
  "name": "@opengovsg/formsg-sdk",
  "version": "8.0.2",
  "description": "Node.js SDK for integrating with FormSG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengovsg/FormSG.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist/",
    "cjs-entry.cjs"
  ],
  "main": "./cjs-entry.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/types": [
        "./dist/cjs/types.d.ts"
      ],
      "adapters": [
        "./dist/cjs/adapters.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./cjs-entry.cjs"
      }
    },
    "./dist/types": {
      "import": {
        "types": "./dist/esm/types.d.ts",
        "default": "./dist/esm/types.js"
      },
      "require": {
        "types": "./dist/cjs/types.d.ts",
        "default": "./dist/cjs/types.js"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/esm/adapters.d.ts",
        "default": "./dist/esm/adapters.js"
      },
      "require": {
        "types": "./dist/cjs/adapters.d.ts",
        "default": "./dist/cjs/adapters.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "lint": "oxlint --quiet --fix src/",
    "lint-ci": "oxlint --quiet src/",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@stablelib/base64": "^1.0.1",
    "@stablelib/utf8": "^1.0.2",
    "axios": "^1.15.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^18.18.9",
    "jest": "^29.7.0",
    "jest-mock-axios": "^4.7.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.5"
  }
}
