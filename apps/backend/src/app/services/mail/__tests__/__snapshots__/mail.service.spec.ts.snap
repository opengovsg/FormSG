exports[`mail.service sendBounceNotification should send permanent bounce notification successfully 1`] = `
[
  [
    {
      "from": "mockApp <from@example.com>",
      "headers": {
        "X-Formsg-Email-Type": "Admin (bounce notification)",
        "X-Formsg-Form-ID": "mockFormId",
      },
      "html": "<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><!--$--><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td><p style="font-size:14px;line-height:24px;margin-top:16px;margin-bottom:16px">Dear form admins(s),</p><p style="font-size:14px;line-height:24px;margin-top:16px;margin-bottom:16px">We’re reaching out urgently regarding your FormSG form<!-- --> <b>You are all individuals!</b> (<a href="mockApp.example.com/mockFormId">mockApp.example.com/mockFormId</a>). Responses to the following recipient(s) could not be delivered:<!-- --> <!-- -->to3@example.com, to4@example.com<!-- -->. This was likely due to their mailbox being full.</p><p style="font-size:14px;line-height:24px;margin-top:16px;margin-bottom:16px">Please refer to our<!-- --> <a href="https://go.gov.sg/formsg-guide-bounces">guide</a> for next steps on how to resolve this issue.</p><p style="font-size:14px;line-height:24px;margin-top:16px;margin-bottom:16px">The <!-- -->mockApp<!-- --> Support Team</p></td></tr></tbody></table></body></html><!--/$-->",
      "subject": "[Urgent] FormSG Response Delivery Failure / Bounce",
      "to": [
        "to@example.com",
        "to2@example.com",
      ],
    },
  ],
]
`;

